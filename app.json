{
  "expo": {
    "name": "TBuddy",
    "slug": "client-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tbuddy-app-icon.png",
    "scheme": "tbuddy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.taulikha.tbuddy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A3E7E2",
        "foregroundImage": "./assets/images/tbuddy-app-icon.png"
      },
      "package": "site.taulikha.tbuddy",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tbuddy-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tbuddy-mark.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F5FBFA"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TBuddy menggunakan lokasimu untuk menampilkan fasilitas kesehatan terdekat."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acfc8510-c988-4e07-a060-509a5cfecd66"
      }
    }
  }
}
